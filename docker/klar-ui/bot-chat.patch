+// @vitest-environment jsdom
+import { act, useState } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { useKlarVoice } from "./useKlarVoice";
+
+let root: Root, host: HTMLDivElement;
+const files = vi.fn();
+class FakeSpeech {
+  static current: FakeSpeech;
+  lang = ""; continuous = false; interimResults = false;
+  onresult: ((event: { results: { 0: { transcript: string }; isFinal: boolean }[] }) => void) | null = null;
+  onerror: ((event: { error: string }) => void) | null = null;
+  onend: (() => void) | null = null;
+  start = vi.fn();
+  stop = vi.fn(() => this.onend?.());
+  abort = vi.fn();
+  constructor() { FakeSpeech.current = this; }
+}
+function Harness() {
+  const [text, setText] = useState("Bitte");
+  const voice = useKlarVoice({ text, onText: setText, onFile: files });
+  return <><output>{text}</output><button onClick={voice.dictate}>Diktieren</button><button onClick={() => { void voice.record(); }}>Aufnehmen</button><p role="status">{voice.mode}</p><p role="alert">{voice.error}</p></>;
+}
+beforeEach(async () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  Object.defineProperty(window, "SpeechRecognition", { value: FakeSpeech, configurable: true });
+  Object.defineProperty(window, "webkitSpeechRecognition", { value: undefined, configurable: true });
+  files.mockReset();
+  host = document.createElement("div"); document.body.append(host); root = createRoot(host);
+  await act(async () => root.render(<Harness />));
+});
+afterEach(async () => {
+  await act(async () => root.unmount()); host.remove();
+  Reflect.deleteProperty(window, "SpeechRecognition"); Reflect.deleteProperty(window, "webkitSpeechRecognition");
+});
+describe("Klar dictation", () => {
+  it("starts only on click and replaces interim text without duplicating it", async () => {
+    await act(async () => host.querySelector("button")!.click());
+    const speech = FakeSpeech.current;
+    expect(speech.start).toHaveBeenCalledTimes(1);
+    expect(speech.lang).toBe("de-CH");
+    await act(async () => speech.onresult?.({ results: [{ 0: { transcript: "den Knopf" }, isFinal: false }] }));
+    await act(async () => speech.onresult?.({ results: [{ 0: { transcript: "den Knopf vergrössern." }, isFinal: true }] }));
+    expect(host.querySelector("output")?.textContent).toBe("Bitte den Knopf vergrössern.");
+    expect(files).not.toHaveBeenCalled();
+    await act(async () => host.querySelector("button")!.click());
+    expect(speech.stop).toHaveBeenCalledTimes(1);
+  });
+  it("retains recognized text when microphone permission is revoked", async () => {
+    await act(async () => host.querySelector("button")!.click());
+    const speech = FakeSpeech.current;
+    await act(async () => { speech.onresult?.({ results: [{ 0: { transcript: "behalten" }, isFinal: true }] }); speech.onerror?.({ error: "not-allowed" }); speech.onend?.(); });
+    expect(host.querySelector("output")?.textContent).toBe("Bitte behalten");
+    expect(host.querySelector('[role="alert"]')?.textContent).toContain("Mikrofonzugriff");
+  });
+  it("explains unsupported recognition without pretending to listen", async () => {
+    Reflect.deleteProperty(window, "SpeechRecognition");
+    await act(async () => root.render(<Harness />));
+    await act(async () => host.querySelector("button")!.click());
+    expect(host.querySelector('[role="alert"]')?.textContent).toContain("keine direkte Diktierfunktion");
+    expect(host.querySelector('[role="status"]')?.textContent).toBe("");
+  });
+});

+++ b/ui/src/components/KlarAttachments.tsx
@@ -0,0 +1,15 @@
+import type { IssueAttachment } from "@paperclipai/shared";
+import { Download } from "lucide-react";
+
+export function KlarAttachments({ attachments }: { attachments: IssueAttachment[] }) {
+  if (!attachments.length) return null;
+  return <div className="klar-message-attachments">{attachments.map(file => {
+    const fallback = `/api/attachments/${encodeURIComponent(file.id)}/content`;
+    const path = file.contentPath?.startsWith("blob:") || file.contentPath?.startsWith("/api/attachments/") ? file.contentPath : fallback;
+    return <div key={file.id} className="klar-message-attachment">
+      {file.contentType.startsWith("image/") && file.contentType !== "image/svg+xml" && <a href={path} target="_blank" rel="noopener noreferrer"><img src={path} loading="lazy" alt={file.originalFilename ?? "Bildanhang"} /></a>}
+      {file.contentType.startsWith("audio/") && <audio src={path} controls preload="metadata" aria-label={file.originalFilename ?? "Sprachnotiz"} />}
+      <a href={path} download={file.originalFilename ?? "Anhang"}><Download className="size-3.5 shrink-0" />{file.originalFilename ?? "Anhang"}</a>
+    </div>;
+  })}</div>;
+}

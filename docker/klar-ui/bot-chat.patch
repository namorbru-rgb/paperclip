+import { useEffect, useRef, useState } from "react";
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import type { Agent, Issue } from "@paperclipai/shared";
+import { ArrowUp, CornerUpLeft, Loader2, Mic, Paperclip, Plus, Square, AudioLines, X } from "lucide-react";
+import { issuesApi } from "../api/issues";
+import { ApiError } from "../api/client";
+import { queryKeys } from "../lib/queryKeys";
+import { chatTaskPayload, type KlarReplyTarget } from "../lib/klar-chat";
+import { sendKlarMessage, type KlarSendProgress } from "../lib/klar-send";
+import { KlarFilePreview } from "./KlarFilePreview";
+import { useKlarVoice } from "./useKlarVoice";
+import { Button } from "./ui/button";
+import { Textarea } from "./ui/textarea";
+
+interface Props {
+  companyId: string;
+  agent: Agent;
+  replyTo: KlarReplyTarget | null;
+  onClearReply: () => void;
+  draft: string;
+  files: File[];
+  savedProgress?: KlarSendProgress;
+  onProgressChange: (progress: KlarSendProgress) => void;
+  onFilesChange: (files: File[]) => void;
+  onDraftChange: (text: string) => void;
+  onSent: (issue?: Issue) => void;
+  onPendingChange?: (pending: boolean) => void;
+}
+
+export function KlarComposer({ companyId, agent, replyTo, onClearReply, draft, files, savedProgress, onProgressChange, onFilesChange, onDraftChange, onSent, onPendingChange }: Props) {
+  const client = useQueryClient();
+  const input = useRef<HTMLTextAreaElement>(null);
+  const locked = useRef(false);
+  const uploadInput = useRef<HTMLInputElement>(null);
+  const progress = useRef<KlarSendProgress | null>(savedProgress ?? null);
+  const [problem, setProblem] = useState("");
+  const [receipt, setReceipt] = useState("");
+  const validAgent = agent.companyId === companyId && !["terminated", "pending_approval"].includes(agent.status);
+  const validTarget = !replyTo || (replyTo.companyId === companyId && replyTo.assigneeAgentId === agent.id);
+  const stopped = ["paused", "error"].includes(agent.status);
+  useEffect(() => { if (replyTo) input.current?.focus(); }, [replyTo?.id]);
+  const send = useMutation({
+    mutationFn: async ({ body, target }: { body: string; target: KlarReplyTarget | null }) => {
+      if (!validAgent || !validTarget) throw new Error("Ungültiges Ziel");
+      if (files.length || progress.current) {
+        progress.current ??= { companyId, agentId: agent.id, text: body, files: [...files], target, attachments: [], committing: false };
+        return sendKlarMessage(progress.current);
+      }
+      if (target) { await issuesApi.addComment(target.id, body); return undefined; }
+      return issuesApi.create(companyId, chatTaskPayload(body, agent.id));
+    },
+    retry: false,
+    onSuccess: (issue, variables) => {
+      progress.current = null;
+      onDraftChange(""); onFilesChange([]);
+      setReceipt(variables.target ? "Antwort gespeichert." : "Aufgabe übergeben. Der tatsächliche Start erscheint im Verlauf.");
+      void client.invalidateQueries({ queryKey: queryKeys.issues.list(companyId) });
+      if (variables.target) void client.invalidateQueries({ queryKey: queryKeys.issues.comments(variables.target.id) });
+      onSent(issue);
+    },
+    onError: error => { if (progress.current) onProgressChange(progress.current); setProblem(error instanceof ApiError && error.status === 401
+      ? "Deine Anmeldung ist abgelaufen. Melde dich in einem zweiten Tab erneut an; dein Text bleibt hier erhalten."
+      : error instanceof ApiError && error.status === 403
+        ? "Dir fehlt die Berechtigung für diese Nachricht. Dein Text bleibt erhalten."
+        : "Das Speichern konnte nicht bestätigt werden. Dein Text bleibt erhalten. Prüfe den Verlauf vor einem erneuten Versuch, damit nichts doppelt angelegt wird."); },
+    onSettled: () => { locked.current = false; onPendingChange?.(false); },
+  });
+  function addFiles(incoming: File[]) {
+    if (send.isPending || progress.current || voice.mode) return;
+    const valid = incoming.filter(file => file.size > 0 && file.size <= 10 * 1024 * 1024);
+    if (valid.length !== incoming.length || files.length + valid.length > 10) setProblem("Bis zu 10 Dateien mit je höchstens 10 MB. Leere oder zu grosse Dateien wurden nicht übernommen.");
+    onFilesChange([...files, ...valid].slice(0, 10));
+  }
+  const voice = useKlarVoice({ text: draft, onText: onDraftChange, onFile: file => onFilesChange([...files, file]) });
+  useEffect(() => { onPendingChange?.(!!voice.mode || send.isPending); }, [voice.mode, send.isPending]);
+  const frozen = send.isPending || !!progress.current || !!voice.mode;
+  function submit() {
+    if ((!draft.trim() && !files.length) || voice.mode || progress.current?.committing || locked.current || !validAgent || !validTarget || (!replyTo && stopped)) return;
+    locked.current = true; onPendingChange?.(true); setProblem(""); setReceipt("");
+    send.mutate({ body: draft.trim(), target: replyTo });
+  }
+  return <form className="klar-chat-composer" onDragOver={event => event.preventDefault()} onDrop={event => { event.preventDefault(); addFiles(Array.from(event.dataTransfer.files)); }} onPaste={event => { const incoming = Array.from(event.clipboardData.files); if (incoming.length) { event.preventDefault(); addFiles(incoming); } }} onSubmit={event => { event.preventDefault(); submit(); }}>
+    {replyTo && <div className="klar-reply-target"><CornerUpLeft className="size-4 shrink-0" /><span>Antwort auf <strong>{replyTo.title}</strong></span><Button type="button" size="icon" variant="ghost" disabled={frozen} onClick={onClearReply} aria-label="Antwortziel entfernen"><X className="size-4" /></Button></div>}
+    <Textarea ref={input} aria-label={replyTo ? `Antwort auf ${replyTo.identifier ?? replyTo.title}` : `Neue Aufgabe für ${agent.name}`} placeholder={replyTo ? "Was möchtest du ergänzen oder ändern?" : `Was soll ${agent.name} für dich tun?`} value={draft} onChange={event => { onDraftChange(event.target.value); setReceipt(""); }} disabled={frozen} className="klar-chat-input" enterKeyHint="send" onKeyDown={event => {
+      if (event.key !== "Enter" || event.shiftKey || event.nativeEvent.isComposing || event.nativeEvent.keyCode === 229) return;
+      event.preventDefault();
+      if (!event.repeat) submit();
+    }} />
+    {files.length > 0 && <div className="klar-attachments">{files.map((file, index) => <KlarFilePreview key={`${file.name}-${index}`} file={file} disabled={frozen} onRemove={() => onFilesChange(files.filter((_, position) => position !== index))} />)}</div>}
+    <input ref={uploadInput} type="file" multiple className="sr-only" aria-label="Bilder und Dateien auswählen" disabled={frozen} onChange={event => { addFiles(Array.from(event.target.files ?? [])); event.target.value = ""; }} />
+    <div className="klar-send-row"><div className="flex items-center gap-1"><Button type="button" variant="ghost" size="icon" disabled={frozen} onClick={() => uploadInput.current?.click()} aria-label="Bild oder Datei anhängen"><Paperclip className="size-5" /></Button><Button type="button" variant="ghost" size="icon" disabled={send.isPending || !!progress.current || (!!voice.mode && voice.mode !== "dictating")} onClick={voice.dictate} aria-label={voice.mode === "dictating" ? "Diktieren stoppen" : "Diktieren"} aria-pressed={voice.mode === "dictating"}>{voice.mode === "dictating" ? <Square className="size-5" /> : <Mic className="size-5" />}</Button><Button type="button" variant="ghost" size="icon" disabled={send.isPending || !!progress.current || voice.mode === "dictating" || voice.mode === "starting"} onClick={() => { void voice.record(); }} aria-label={voice.mode === "recording" ? "Sprachnotiz beenden" : "Sprachnotiz aufnehmen"} aria-pressed={voice.mode === "recording"}>{voice.mode === "recording" ? <Square className="size-5" /> : <AudioLines className="size-5" />}</Button></div><span className="klar-composer-mode">{replyTo ? "Antwort" : "Neue Aufgabe"}</span><Button type="submit" size="icon" className="rounded-full" aria-label={replyTo ? "Antwort senden" : "Aufgabe senden"} disabled={(!draft.trim() && !files.length) || !!voice.mode || !!progress.current?.committing || send.isPending || !validAgent || !validTarget || (!replyTo && stopped)}>{send.isPending ? <Loader2 className="size-5 animate-spin" /> : <ArrowUp className="size-5" />}</Button></div>
+    {voice.mode && <p role="status" className="text-xs text-muted-foreground">{voice.mode === "dictating" ? "Diktiere jetzt. Der Text bleibt vor dem Senden bearbeitbar." : voice.mode === "starting" ? "Mikrofon wird geöffnet…" : "Sprachnotiz wird aufgenommen · höchstens 5 Minuten"}</p>}
+    {voice.error && <p role="alert" className="text-sm text-destructive">{voice.error}</p>}
+    {progress.current && !send.isPending && <p className="text-xs text-muted-foreground">{progress.current.committing ? "Versandstatus unklar. Bitte den Verlauf prüfen, bevor du eine weitere Nachricht sendest." : "Der Upload ist unvollständig. Der Entwurf bleibt erhalten; mit Senden setzt du ihn fort."}</p>}
+    {!validAgent && <p role="alert" className="text-sm text-destructive">Dieser Bot kann gerade keine Aufgaben empfangen.</p>}
+    {!validTarget && <p role="alert" className="text-sm text-destructive">Die Aufgabe gehört nicht mehr zu diesem Bot. Bitte aktualisieren.</p>}
+    {stopped && !replyTo && <p className="text-xs text-muted-foreground">Der Bot läuft gerade nicht. Du kannst bestehenden Aufgaben antworten; neue Aufgaben sind bis zur Klärung gesperrt.</p>}
+    {replyTo && ["done", "cancelled"].includes(replyTo.status) && <p className="text-xs text-muted-foreground">Diese Aufgabe ist abgeschlossen. Deine Antwort ergänzt den Verlauf. Für neue Arbeit erstelle eine neue Aufgabe.</p>}
+    {problem && <p role="alert" className="text-sm text-destructive">{problem}</p>}
+    {receipt && <p role="status" className="text-xs text-muted-foreground">{receipt}</p>}
+  </form>;
+}

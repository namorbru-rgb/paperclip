+import type { Issue, IssueAttachment } from "@paperclipai/shared";
+import { issuesApi } from "../api/issues";
+import { chatTaskPayload, type KlarReplyTarget } from "./klar-chat";
+
+export interface KlarSendProgress {
+  companyId: string; agentId: string; text: string; files: File[]; target: KlarReplyTarget | null;
+  created?: Issue; attachments: IssueAttachment[]; committing: boolean;
+}
+/** Create an unassigned draft first; hand off only after every attachment exists. */
+export async function sendKlarMessage(progress: KlarSendProgress): Promise<Issue | undefined> {
+  if (progress.committing) throw new Error("Der letzte Versand muss im Verlauf geprüft werden.");
+  if (!progress.target && !progress.created) {
+    progress.created = await issuesApi.create(progress.companyId, {
+      title: chatTaskPayload(progress.text || progress.files[0]?.name || "Neue Aufgabe", progress.agentId).title,
+      description: progress.text, status: "backlog", priority: "medium", workMode: "standard",
+    });
+  }
+  const issueId = progress.target?.id ?? progress.created!.id;
+  for (let index = progress.attachments.length; index < progress.files.length; index++) {
+    progress.attachments.push(await issuesApi.uploadAttachment(progress.companyId, issueId, progress.files[index]));
+  }
+  const links = progress.attachments.map(attachment => {
+    const name = (attachment.originalFilename ?? "Anhang").replace(/[\[\]\\]/g, "");
+    return `[${name}](/api/attachments/${encodeURIComponent(attachment.id)}/content)`;
+  });
+  const body = [progress.text.trim(), links.join("\n")].filter(Boolean).join("\n\n");
+  progress.committing = true;
+  // An uncertain final write is never retried automatically.
+  if (progress.target) { await issuesApi.addComment(issueId, body); return undefined; }
+  return issuesApi.update(issueId, { description: body, status: "todo", assigneeAgentId: progress.agentId });
+}

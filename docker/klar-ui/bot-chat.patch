+import { useEffect, useMemo, useRef, useState } from "react";
+import { useInfiniteQuery, useQueries, useQuery } from "@tanstack/react-query";
+import type { Agent, CompactIssue } from "@paperclipai/shared";
+import { ArrowLeft, CornerUpLeft, Info, Plus } from "lucide-react";
+import { Link } from "@/lib/router";
+import { issuesApi } from "../api/issues";
+import { queryKeys } from "../lib/queryKeys";
+import { botLabels, chatTimeline, taskLabels, type KlarReplyTarget } from "../lib/klar-chat";
+import { KlarAttachments } from "./KlarAttachments";
+import { KlarComposer } from "./KlarComposer";
+import { MarkdownBody } from "./MarkdownBody";
+import { Button } from "./ui/button";
+import { Dialog, DialogContent, DialogDescription, DialogHeader, DialogTitle } from "./ui/dialog";
+
+const PAGE_SIZE = 12;
+export interface ChatDraft { text: string; replyTo: KlarReplyTarget | null; files: File[]; progress?: import("../lib/klar-send").KlarSendProgress }
+interface Props {
+  companyId: string; agent: Agent; agents: Agent[];
+  currentUserId?: string | null; draft: ChatDraft; onDraftChange: (draft: ChatDraft) => void;
+  onBack: () => void; onResolved: () => void; onPendingChange: (pending: boolean) => void;
+}
+export function KlarBotChat({ companyId, agent, agents, currentUserId, draft, onDraftChange, onBack, onResolved, onPendingChange }: Props) {
+  const [details, setDetails] = useState<CompactIssue | null>(null);
+  const [showBot, setShowBot] = useState(false);
+  const [pending, setPending] = useState(false);
+  const [commentLimit, setCommentLimit] = useState(12);
+  const bottom = useRef<HTMLDivElement>(null);
+  const sent = useRef(false);
+  const tasks = useInfiniteQuery({
+    queryKey: [...queryKeys.issues.list(companyId), "klar-chat", agent.id],
+    queryFn: ({ pageParam }) => issuesApi.listCompact(companyId, { assigneeAgentId: agent.id, includeRoutineExecutions: true, limit: PAGE_SIZE, offset: pageParam, sortField: "updated", sortDir: "desc" }),
+    initialPageParam: 0,
+    getNextPageParam: (last, pages) => last.length === PAGE_SIZE ? pages.length * PAGE_SIZE : undefined,
+    refetchInterval: 15_000,
+  });
+  const loadedTasks = useMemo(() => [...new Map((tasks.data?.pages.flat() ?? []).filter(task => task.companyId === companyId && task.assigneeAgentId === agent.id).map(task => [task.id, task])).values()], [tasks.data, companyId, agent.id]);
+  const comments = useQueries({ queries: loadedTasks.map(task => ({
+    queryKey: [...queryKeys.issues.comments(task.id), "klar-chat", commentLimit],
+    queryFn: () => issuesApi.listComments(task.id, { order: "desc", limit: commentLimit }),
+    refetchInterval: 15_000,
+  })) });
+  const attachmentQueries = useQueries({ queries: loadedTasks.map(task => ({ queryKey: queryKeys.issues.attachments(task.id), queryFn: () => issuesApi.listAttachments(task.id), refetchInterval: 30_000 })) });
+  const attachments = attachmentQueries.flatMap(query => query.data ?? []).filter(file => file.companyId === companyId);
+  const allComments = comments.flatMap(query => query.data ?? []);
+  const timeline = chatTimeline(loadedTasks, comments.flatMap(query => query.data ?? []));
+  const agentMap = useMemo(() => new Map(agents.map(item => [item.id, item])), [agents]);
+  const fullTask = useQuery({ queryKey: queryKeys.issues.detail(details?.id ?? ""), queryFn: () => issuesApi.get(details!.id), enabled: !!details });
+  const refresh = () => { void tasks.refetch(); for (const query of comments) void query.refetch(); for (const query of attachmentQueries) void query.refetch(); onResolved(); };
+  useEffect(() => { if (sent.current) { bottom.current?.scrollIntoView?.({ block: "end", behavior: "smooth" }); sent.current = false; } }, [timeline.length]);
+  const reply = (task: CompactIssue) => { if (!pending && !draft.progress) onDraftChange({ ...draft, replyTo: task }); };
+  const currentReply = draft.replyTo ? loadedTasks.find(task => task.id === draft.replyTo?.id) ?? draft.replyTo : null;
+
+  return <section className="klar-conversation" aria-label={`Chat mit ${agent.name}`}>
+    <header className="klar-chat-header"><Button variant="ghost" size="icon" disabled={pending} onClick={onBack} aria-label="Zur Bot-Übersicht"><ArrowLeft className="size-5" /></Button><span className="klar-avatar">{agent.name.slice(0, 2).toUpperCase()}</span><div className="min-w-0 flex-1"><h1 className="font-semibold truncate">{agent.name}</h1><p className="text-xs text-muted-foreground">{botLabels[agent.status] ?? "Status unbekannt"}</p></div><Button variant="ghost" size="icon" onClick={() => setShowBot(true)} aria-label="Bot-Details"><Info className="size-5" /></Button></header>
+    <div className="klar-chat-scroll">
+      <div className="klar-chat-stream" aria-label="Nachrichten">
+        {tasks.hasNextPage && <Button variant="ghost" disabled={tasks.isFetchingNextPage} onClick={() => { void tasks.fetchNextPage(); }}>Ältere Aufgaben laden</Button>}
+        {tasks.isPending && <p role="status">Gespräch wird geladen…</p>}
+        {tasks.isError && <p role="alert" className="text-sm text-destructive">Die Aufgaben konnten nicht geladen werden. <button onClick={() => { void tasks.refetch(); }} className="underline">Erneut laden</button></p>}
+        {comments.some(query => query.isError) && <p role="alert" className="text-sm text-destructive">Ein Teil der Antworten konnte nicht geladen werden. <button onClick={refresh} className="underline">Erneut laden</button></p>}
+        {!tasks.isPending && !tasks.isError && loadedTasks.length === 0 && <div className="klar-empty-chat"><h2>Was soll {agent.name} für dich tun?</h2><p>Schreib einfach los. Deine Nachricht wird zur Aufgabe für diesen Bot.</p></div>}
+        {timeline.map(event => {
+          const { task, comment } = event;
+          const authorId = comment?.authorAgentId ?? comment?.derivedAuthorAgentId;
+          const author = comment ? authorId ? agentMap.get(authorId)?.name ?? "Bot" : comment.authorUserId === currentUserId ? "Du" : "Team" : "Aufgabe";
+          return <article key={event.id} className={comment && authorId ? "klar-message klar-bot-message" : "klar-message klar-task-message"} data-message-id={event.id}>
+            <div className="klar-message-meta"><span>{author}</span><time dateTime={event.at.toISOString()}>{event.at.toLocaleString("de-CH", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" })}</time></div>
+            <div className="klar-message-body">{comment ? <><button type="button" className="klar-message-reference" onClick={() => setDetails(task)}>{task.identifier} · {task.title}</button><MarkdownBody>{comment.body}</MarkdownBody></> : <button type="button" className="klar-task-open" onClick={() => setDetails(task)}><span className="text-xs text-muted-foreground">{task.identifier} · {taskLabels[task.status] ?? task.status}</span><strong>{task.title}</strong><span className="text-xs text-muted-foreground">Aufgabe ansehen</span></button>}</div>
+            <KlarAttachments attachments={attachments.filter(file => file.issueId === task.id && (comment ? comment.body.includes(file.id) || file.issueCommentId === comment.id : !allComments.some(message => message.issueId === task.id && (message.body.includes(file.id) || message.id === file.issueCommentId))))} />
+            <Button type="button" variant="ghost" size="sm" className="klar-reply-button" disabled={pending} onClick={() => reply(task)} aria-label={`Auf ${task.identifier ?? task.title} antworten`}><CornerUpLeft className="size-3.5" />Antworten</Button>
+          </article>;
+        })}
+        {comments.some(query => (query.data?.length ?? 0) >= commentLimit) && <Button variant="ghost" onClick={() => setCommentLimit(limit => limit + 24)}>Weitere Antworten laden</Button>}
+      </div>
+      <div ref={bottom} />
+    </div>
+    <div className="klar-composer-dock">{draft.replyTo && <Button variant="ghost" size="sm" disabled={pending || !!draft.progress} onClick={() => onDraftChange({ ...draft, replyTo: null })}><Plus className="size-4" />Als neue Aufgabe schreiben</Button>}<KlarComposer companyId={companyId} agent={agent} replyTo={currentReply} draft={draft.text} files={draft.files} savedProgress={draft.progress} onProgressChange={progress => onDraftChange({ ...draft, progress })} onFilesChange={files => onDraftChange({ ...draft, files })} onDraftChange={text => onDraftChange({ ...draft, text })} onClearReply={() => onDraftChange({ ...draft, replyTo: null })} onSent={issue => { sent.current = true; onDraftChange({ text: "", files: [], replyTo: issue ?? draft.replyTo }); refresh(); }} onPendingChange={value => { setPending(value); onPendingChange(value); }} /></div>
+    <Dialog open={!!details} onOpenChange={open => { if (!open) setDetails(null); }}><DialogContent lang="de-CH" translate="no" className="klar-theme klar-details notranslate"><DialogHeader><DialogTitle>{details?.title}</DialogTitle><DialogDescription>{details?.identifier} · {details ? taskLabels[details.status] : ""}</DialogDescription></DialogHeader>{fullTask.isPending ? <p>Aufgabe wird geladen…</p> : fullTask.isError || fullTask.data?.companyId !== companyId ? <p role="alert">Die Details konnten nicht geladen werden.</p> : <MarkdownBody>{fullTask.data.description ?? "Keine zusätzliche Beschreibung."}</MarkdownBody>}<div className="flex flex-wrap gap-2"><Button disabled={pending} onClick={() => { if (details) reply(details); setDetails(null); }}><CornerUpLeft className="size-4" />Darauf antworten</Button><Button variant="outline" asChild><Link to={`/issues/${details?.identifier ?? details?.id}`}>Alle Aufgabendetails</Link></Button></div></DialogContent></Dialog>
+    <Dialog open={showBot} onOpenChange={setShowBot}><DialogContent lang="de-CH" translate="no" className="klar-theme klar-details notranslate"><DialogHeader><DialogTitle>{agent.name}</DialogTitle><DialogDescription>{agent.title || "Dein Bot"}</DialogDescription></DialogHeader><p>{botLabels[agent.status]}</p>{agent.capabilities && <MarkdownBody>{agent.capabilities}</MarkdownBody>}<Button variant="outline" asChild><Link to={`/agents/${agent.id}`}>Bot-Einstellungen öffnen</Link></Button></DialogContent></Dialog>
+  </section>;
+}

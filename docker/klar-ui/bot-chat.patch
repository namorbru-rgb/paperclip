+import type { Agent, Approval, AttentionItem, CompactIssue, IssueComment } from "@paperclipai/shared";
+import type { LiveRunForIssue } from "../api/heartbeats";
+
+export const taskLabels: Record<string, string> = { backlog: "Geplant", todo: "Bereit", in_progress: "In Arbeit", in_review: "In Prüfung", blocked: "Blockiert", done: "Erledigt gemeldet", cancelled: "Abgebrochen" };
+export const botLabels: Record<string, string> = { running: "Arbeitet", idle: "Hat gerade nichts zu tun", active: "Bereit", paused: "Pausiert", error: "Fehler – braucht Hilfe", terminated: "Gestoppt", pending_approval: "Einrichtung offen" };
+export const needsApproval = (approval: Approval) => ["pending", "revision_requested"].includes(approval.status);
+export const isRunning = (run: LiveRunForIssue) => run.status === "running" && !run.finishedAt;
+
+export function decisionAgentId(item: AttentionItem): string | null {
+  const metadata = item.subject.metadata;
+  const value = metadata?.createdByAgentId ?? metadata?.requestedByAgentId ?? item.resolverAudience?.createdByAgentId;
+  return typeof value === "string" ? value : null;
+}
+
+/** Dismissed cards must not hide an unresolved decision. */
+export function botRank(agent: Agent, approvalCount: number, runs: LiveRunForIssue[]): number {
+  if (approvalCount > 0 || agent.status === "pending_approval") return 0;
+  if (agent.status === "running" || runs.some(run => run.agentId === agent.id && isRunning(run))) return 1;
+  if (["paused", "error", "terminated"].includes(agent.status)) return 2;
+  return 3;
+}
+
+export function chatTaskPayload(text: string, agentId: string) {
+  const body = text.trim();
+  if (!body || !agentId) throw new Error("Nachricht und Bot fehlen.");
+  return { title: Array.from(body.split(/\r?\n/)[0]).slice(0, 160).join(""), description: body, assigneeAgentId: agentId, status: "todo", priority: "medium", workMode: "standard" };
+}
+
+/** Resolve only an explicit name at the start; otherwise use this company's CEO. */
+export function newTaskAgent(text: string, companyId: string, agents: Agent[]): Agent {
+  const team = agents.filter(agent => agent.companyId === companyId);
+  const body = text.trim();
+  const explicit = /^(?:(?:aufgabe|auftrag)\s+(?:für|an)\s+|@)/iu.test(body);
+  const address = body.replace(/^(?:aufgabe|auftrag)\s+(?:für|an)\s+/iu, "").replace(/^@/, "");
+  const named = team.filter(agent => {
+    const escaped = agent.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+    return new RegExp(`^${escaped}(?:\\s|[:,.!?]|$)`, "iu").test(address);
+  }).sort((a, b) => b.name.length - a.name.length);
+  if (explicit && !named.length) throw new Error("Diesen Bot finde ich nicht. Nenne seinen vollständigen Namen am Anfang der Nachricht.");
+  const candidates = named.length ? named.filter(agent => agent.name.length === named[0].name.length) : team.filter(agent => agent.role === "ceo");
+  if (candidates.length !== 1) throw new Error(named.length ? "Der Bot-Name ist nicht eindeutig. Bitte verwende einen eindeutigen Namen." : "Die automatische Zuordnung ist nicht eindeutig. Beginne mit dem Namen eines Bots, zum Beispiel: Atlas, …");
+  const agent = candidates[0];
+  if (!["idle", "active", "running"].includes(agent.status)) throw new Error(`${agent.name} ist gerade nicht einsatzbereit. Deine Nachricht bleibt erhalten.`);
+  return agent;
+}
+
+export function priorityTaskPayload(text: string, companyId: string, agents: Agent[]) {
+  const agent = newTaskAgent(text, companyId, agents);
+  return { ...chatTaskPayload(text, agent.id), priority: "critical" };
+}
+
+export type KlarReplyTarget = Pick<CompactIssue, "id" | "companyId" | "assigneeAgentId" | "identifier" | "title" | "status">;
+export type ChatEvent = { id: string; at: Date; task: CompactIssue; comment?: IssueComment };
+export function chatTimeline(tasks: CompactIssue[], comments: IssueComment[]): ChatEvent[] {
+  const byId = new Map(tasks.map(task => [task.id, task]));
+  const events: ChatEvent[] = tasks.map(task => ({ id: `task-${task.id}`, at: new Date(task.createdAt), task }));
+  for (const comment of comments) {
+    const task = byId.get(comment.issueId);
+    if (task && comment.companyId === task.companyId && !comment.deletedAt) events.push({ id: `comment-${comment.id}`, at: new Date(comment.createdAt), task, comment });
+  }
+  return events.sort((a, b) => a.at.getTime() - b.at.getTime() || a.id.localeCompare(b.id));
+}

@@ -0,0 +1,115 @@
+// @vitest-environment jsdom
+import { act, useState } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Agent } from "@paperclipai/shared";
+import { KlarComposer } from "./KlarComposer";
+import { ApiError } from "../api/client";
+import type { KlarReplyTarget } from "../lib/klar-chat";
+
+const mocks = vi.hoisted(() => ({ create: vi.fn(), addComment: vi.fn(), update: vi.fn(), uploadAttachment: vi.fn() }));
+vi.mock("../api/issues", () => ({ issuesApi: mocks }));
+vi.mock("./KlarFilePreview", () => ({ KlarFilePreview: ({ file }: { file: File }) => <span>{file.name}</span> }));
+let root: Root, host: HTMLDivElement, client: QueryClient;
+const agent = { id: "bot-a", companyId: "company-a", name: "Nora", status: "running" } as Agent;
+const task = { id: "task-a", companyId: "company-a", assigneeAgentId: "bot-a", identifier: "DEMO-1", title: "Kontaktseite", status: "in_progress" } as KlarReplyTarget;
+function Harness({ owner = agent, target = null, initialFiles = [] }: { owner?: Agent; target?: KlarReplyTarget | null; initialFiles?: File[] }) {
+  const [text, setText] = useState("");
+  const [files, setFiles] = useState(initialFiles);
+  return <KlarComposer companyId="company-a" agent={owner} replyTo={target} onClearReply={() => {}} draft={text} onDraftChange={setText} files={files} onFilesChange={setFiles} onProgressChange={() => {}} onSent={() => {}} />;
+}
+function render(props: Parameters<typeof Harness>[0] = {}) { root.render(<QueryClientProvider client={client}><Harness {...props} /></QueryClientProvider>); }
+function sendButton() { return host.querySelector<HTMLButtonElement>('button[type="submit"]')!; }
+async function fill(text: string) {
+  await act(async () => {
+    const field = host.querySelector("textarea")!;
+    Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, "value")!.set!.call(field, text);
+    field.dispatchEvent(new Event("input", { bubbles: true }));
+  });
+}
+async function send() { await act(async () => { sendButton().click(); }); }
+beforeEach(async () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  Object.values(mocks).forEach(mock => mock.mockReset());
+  client = new QueryClient({ defaultOptions: { queries: { retry: false }, mutations: { retry: false } } });
+  host = document.createElement("div"); document.body.append(host); root = createRoot(host);
+  await act(async () => render());
+});
+afterEach(async () => { await act(async () => root.unmount()); host.remove(); client.clear(); });
+
+describe("Klar single-field chat", () => {
+  it("keeps one text field, attachment and voice controls without making a request while typing", async () => {
+    expect(host.querySelectorAll("textarea")).toHaveLength(1);
+    expect(host.querySelectorAll('input:not([type="file"])')).toHaveLength(0);
+    expect(host.querySelector('[aria-label="Diktieren"]')).not.toBeNull();
+    expect(host.querySelector('[aria-label="Sprachnotiz aufnehmen"]')).not.toBeNull();
+    await fill("Mach die Kontaktseite einfacher.");
+    expect(mocks.create).not.toHaveBeenCalled();
+  });
+  it("creates exactly one task for the selected bot on double-click", async () => {
+    let finish!: (value: unknown) => void;
+    mocks.create.mockImplementation(() => new Promise(resolve => { finish = resolve; }));
+    await fill("Mach die Kontaktseite einfacher.\nMit grossem Kontaktknopf.");
+    await act(async () => { sendButton().click(); sendButton().click(); });
+    expect(mocks.create).toHaveBeenCalledTimes(1);
+    expect(mocks.create).toHaveBeenCalledWith("company-a", expect.objectContaining({ assigneeAgentId: "bot-a", status: "todo", description: "Mach die Kontaktseite einfacher.\nMit grossem Kontaktknopf." }));
+    await act(async () => finish({ id: "new-task" }));
+    await vi.waitFor(() => expect(host.querySelector("textarea")?.value).toBe(""));
+  });
+  it("replies to the selected task without reopening it or interrupting a run", async () => {
+    mocks.addComment.mockResolvedValue({ id: "comment" });
+    await act(async () => render({ target: task }));
+    await fill("Bitte den Knopf grösser machen.");
+    await act(async () => { host.querySelector("textarea")!.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true, cancelable: true })); });
+    expect(mocks.addComment).toHaveBeenCalledWith("task-a", "Bitte den Knopf grösser machen.");
+    expect(mocks.create).not.toHaveBeenCalled();
+  });
+  it("keeps Shift+Enter and composition confirmation from sending and ignores held Enter", async () => {
+    await fill("Noch nicht senden");
+    const field = host.querySelector("textarea")!;
+    for (const init of [{ shiftKey: true }, { isComposing: true }, { keyCode: 229 }, { repeat: true }]) {
+      await act(async () => { field.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true, cancelable: true, ...init })); });
+    }
+    expect(mocks.create).not.toHaveBeenCalled();
+    expect(field.value).toBe("Noch nicht senden");
+    expect(field.getAttribute("enterkeyhint")).toBe("send");
+  });
+  it("keeps text after an expired login", async () => {
+    mocks.create.mockRejectedValue(new ApiError("Unauthorized", 401, {}));
+    await fill("Mein Text bleibt."); await send();
+    await vi.waitFor(() => expect(host.textContent).toContain("Anmeldung ist abgelaufen"));
+    expect(host.querySelector("textarea")?.value).toBe("Mein Text bleibt.");
+  });
+  it("does not send to another company or a reassigned task", async () => {
+    await act(async () => render({ target: { ...task, assigneeAgentId: "other-bot" } }));
+    await fill("Nicht senden"); await send();
+    expect(sendButton().disabled).toBe(true);
+    expect(mocks.addComment).not.toHaveBeenCalled();
+    await act(async () => render({ owner: { ...agent, companyId: "company-b" } }));
+    expect(sendButton().disabled).toBe(true);
+    expect(mocks.create).not.toHaveBeenCalled();
+  });
+  it("does not start a paused bot but permits comments on its tasks", async () => {
+    await act(async () => render({ owner: { ...agent, status: "paused" } }));
+    await fill("Prüfen");
+    expect(sendButton().disabled).toBe(true);
+    await act(async () => render({ owner: { ...agent, status: "paused" }, target: task }));
+    expect(sendButton().disabled).toBe(false);
+  });
+  it("supports a file-only message and assigns only after upload", async () => {
+    const file = new File(["image"], "bild.png", { type: "image/png" });
+    mocks.create.mockResolvedValue({ id: "draft", companyId: "company-a" });
+    mocks.uploadAttachment.mockResolvedValue({ id: "attachment", originalFilename: "bild.png", contentType: "image/png" });
+    mocks.update.mockResolvedValue({ id: "draft", assigneeAgentId: "bot-a" });
+    await act(async () => render({ initialFiles: [file] }));
+    // Remount so the initial file state is applied.
+    await act(async () => { root.render(<QueryClientProvider client={client}><Harness key="files" initialFiles={[file]} /></QueryClientProvider>); });
+    await send();
+    await vi.waitFor(() => expect(mocks.update).toHaveBeenCalledTimes(1));
+    expect(mocks.create.mock.calls[0][1]).not.toHaveProperty("assigneeAgentId");
+    expect(mocks.create.mock.calls[0][1].status).toBe("backlog");
+    expect(mocks.uploadAttachment).toHaveBeenCalledWith("company-a", "draft", file);
+    expect(mocks.update.mock.invocationCallOrder[0]).toBeGreaterThan(mocks.uploadAttachment.mock.invocationCallOrder[0]);
+  });
+});

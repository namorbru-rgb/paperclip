+import { useRef, useState } from "react";
+import { useMutation } from "@tanstack/react-query";
+import type { Agent } from "@paperclipai/shared";
+import { ArrowUp, Loader2, X } from "lucide-react";
+import { issuesApi } from "../api/issues";
+import { ApiError } from "../api/client";
+import { priorityTaskPayload } from "../lib/klar-chat";
+import { Button } from "./ui/button";
+import { Textarea } from "./ui/textarea";
+import { Dialog, DialogContent, DialogDescription, DialogTitle } from "./ui/dialog";
+
+interface Props {
+  companyId: string;
+  agents: Agent[];
+  ready: boolean;
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  draft: string;
+  onDraftChange: (text: string) => void;
+  onCreated: () => void;
+}
+
+export function KlarNewTask({ companyId, agents, ready, open, onOpenChange, draft, onDraftChange, onCreated }: Props) {
+  const input = useRef<HTMLTextAreaElement>(null);
+  const locked = useRef(false);
+  const [problem, setProblem] = useState("");
+  const [receipt, setReceipt] = useState("");
+  const send = useMutation({
+    mutationFn: (payload: ReturnType<typeof priorityTaskPayload>) => issuesApi.create(companyId, payload),
+    retry: false,
+    onSuccess: issue => {
+      onDraftChange("");
+      const owner = agents.find(agent => agent.companyId === companyId && agent.id === issue.assigneeAgentId);
+      setReceipt(owner ? `Aufgabe für ${owner.name} gespeichert.` : "Aufgabe gespeichert.");
+      onCreated();
+      input.current?.focus();
+    },
+    onError: error => setProblem(error instanceof ApiError && error.status === 401
+      ? "Deine Anmeldung ist abgelaufen. Dein Text bleibt erhalten."
+      : error instanceof ApiError && error.status === 403
+        ? "Dir fehlt die Berechtigung für diese Aufgabe. Dein Text bleibt erhalten."
+        : "Das Speichern konnte nicht bestätigt werden. Prüfe den Verlauf vor einem erneuten Versuch, damit nichts doppelt angelegt wird."),
+    onSettled: () => { locked.current = false; },
+  });
+  function submit() {
+    if (!draft.trim() || !ready || locked.current) return;
+    setProblem(""); setReceipt("");
+    try {
+      const payload = priorityTaskPayload(draft, companyId, agents);
+      locked.current = true;
+      send.mutate(payload);
+    } catch (error) {
+      setProblem(error instanceof Error ? error.message : "Die Aufgabe konnte nicht zugeordnet werden.");
+    }
+  }
+  return <Dialog open={open} onOpenChange={value => { if (!locked.current) onOpenChange(value); }}>
+    <DialogContent lang="de-CH" translate="no" className="klar-theme klar-new-task-dialog notranslate" showCloseButton={false} onOpenAutoFocus={event => { event.preventDefault(); input.current?.focus(); }} onEscapeKeyDown={event => { if (locked.current) event.preventDefault(); }} onPointerDownOutside={event => { if (locked.current) event.preventDefault(); }}>

@@ -0,0 +1,65 @@
+import { useRef, useState } from "react";
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import type { Agent, Approval, AttentionItem } from "@paperclipai/shared";
+import { Check, ChevronDown, Pin, X } from "lucide-react";
+import { Link } from "@/lib/router";
+import { approvalsApi } from "../api/approvals";
+import { queryKeys } from "../lib/queryKeys";
+import { AttentionInteractionResolver } from "./AttentionInteractionResolver";
+import { MarkdownBody } from "./MarkdownBody";
+import { Button } from "./ui/button";
+import { needsApproval } from "../lib/klar-chat";
+
+const fieldLabels: Record<string, string> = {
+  title: "Titel", summary: "Zusammenfassung", recommendedAction: "Vorgeschlagene Aktion",
+  nextActionOnApproval: "Nach deiner Freigabe", risks: "Risiken", proposedComment: "Vorgeschlagener Kommentar",
+  name: "Name", role: "Rolle", capabilities: "Fähigkeiten", adapterType: "Anbindung", adapterConfig: "Konfiguration",
+  scopeName: "Geltungsbereich", scopeType: "Art", budgetAmount: "Budget", observedAmount: "Verbrauch",
+  windowKind: "Zeitraum", guidance: "Hinweise", plan: "Plan", description: "Beschreibung", strategy: "Strategie",
+};
+export function KlarApproval({ approval, onResolved }: { approval: Approval; onResolved: () => void }) {
+  const [open, setOpen] = useState(false);
+  const [error, setError] = useState("");
+  const locked = useRef(false);
+  const client = useQueryClient();
+  const decision = useMutation({
+    mutationFn: (accept: boolean) => accept ? approvalsApi.approve(approval.id) : approvalsApi.reject(approval.id),
+    retry: false,
+    onSuccess: result => {
+      client.setQueryData<Approval[]>(queryKeys.approvals.list(approval.companyId), current => current?.map(item => item.id === result.id ? result : item));
+      void client.invalidateQueries({ queryKey: queryKeys.approvals.list(approval.companyId) });
+      void client.invalidateQueries({ queryKey: queryKeys.attention(approval.companyId) });
+      onResolved();
+    },
+    onError: () => setError("Die Entscheidung konnte nicht bestätigt werden. Bitte aktualisieren und den Status prüfen."),
+    onSettled: () => { locked.current = false; },
+  });
+  const title = [approval.payload.title, approval.payload.name, approval.payload.summary].find(value => typeof value === "string" && value.trim()) as string | undefined;
+  function decide(accept: boolean) {
+    if (locked.current || !open || !needsApproval(approval)) return;
+    locked.current = true; setError(""); decision.mutate(accept);
+  }
+  return <article className="klar-decision" data-approval-id={approval.id}>
+    <div className="flex items-center gap-2 text-xs font-medium"><Pin className="size-3.5" />Deine Freigabe ist offen</div>
+    <div className="flex items-start justify-between gap-3"><p className="font-medium break-words">{title || "Anfrage zur Freigabe"}</p><Button type="button" variant="ghost" size="sm" aria-expanded={open} onClick={() => setOpen(value => !value)}><span>{open ? "Schliessen" : "Prüfen"}</span><ChevronDown className="size-4" /></Button></div>
+    {open && <div className="space-y-4">
+      <dl className="klar-approval-payload">{Object.entries(approval.payload).filter(([, value]) => value !== null && value !== undefined && value !== "").map(([key, value]) => <div key={key}><dt>{fieldLabels[key] ?? key}</dt><dd>{typeof value === "string" ? <MarkdownBody>{value}</MarkdownBody> : <pre>{JSON.stringify(value, null, 2)}</pre>}</dd></div>)}</dl>
+      <div className="flex gap-2"><Button type="button" disabled={decision.isPending || !needsApproval(approval)} onClick={() => decide(true)}><Check className="size-4" />Freigeben</Button><Button type="button" variant="outline" disabled={decision.isPending || !needsApproval(approval)} onClick={() => decide(false)}><X className="size-4" />Ablehnen</Button></div>
+    </div>}
+    {error && <p role="alert" className="text-sm text-destructive">{error}</p>}
+  </article>;
+}
+
+export function KlarAttention({ item, agentMap, currentUserId, onResolved }: { item: AttentionItem; agentMap: Map<string, Agent>; currentUserId?: string | null; onResolved: () => void }) {
+  const [open, setOpen] = useState(false);
+  const issueId = item.relatedIssue?.id ?? (typeof item.subject.metadata?.issueId === "string" ? item.subject.metadata.issueId : null);
+  // Preserve the native resolver for plans, tool actions, secrets and audience policies.
+  const inline = item.sourceKind === "issue_thread_interaction" && issueId && item.subject.companyId === item.companyId;
+  const href = item.subject.href;
+  const localHref = href && href.startsWith("/") && !href.startsWith("//") ? href : "/inbox";
+  return <article className="klar-decision" data-decision-id={item.id}>
+    <div className="flex items-center gap-2 text-xs font-medium"><Pin className="size-3.5" />Entscheidung offen</div>
+    <p className="font-medium break-words">{item.subject.title ?? item.relatedIssue?.title ?? "Deine Entscheidung wird benötigt"}</p>
+    {inline ? <><Button type="button" variant="outline" size="sm" aria-expanded={open} onClick={() => setOpen(value => !value)}>{open ? "Details schliessen" : "Prüfen und entscheiden"}</Button>{open && <AttentionInteractionResolver companyId={item.companyId} issueId={issueId} interactionId={item.subject.id} agentMap={agentMap} currentUserId={currentUserId} onResolved={onResolved} />}</> : <Button variant="outline" size="sm" asChild><Link to={localHref}>Entscheidung mit allen Details öffnen</Link></Button>}
+  </article>;
+}

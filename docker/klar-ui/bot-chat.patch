+// @vitest-environment jsdom
+import { act, useState, type ReactNode } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { beforeEach, afterEach, describe, expect, it, vi } from "vitest";
+import type { Agent, CompactIssue } from "@paperclipai/shared";
+import { KlarBotChat, type ChatDraft } from "./KlarBotChat";
+import { queryKeys } from "../lib/queryKeys";
+const api = vi.hoisted(() => ({ listCompact: vi.fn(), listComments: vi.fn(), listAttachments: vi.fn(), get: vi.fn(), addComment: vi.fn(), approve: vi.fn(), reject: vi.fn() }));
+vi.mock("../api/issues", () => ({ issuesApi: api }));
+vi.mock("../api/approvals", () => ({ approvalsApi: api }));
+vi.mock("./MarkdownBody", () => ({ MarkdownBody: ({ children }: { children: ReactNode }) => <div>{children}</div> }));
+vi.mock("./AttentionInteractionResolver", () => ({ AttentionInteractionResolver: () => <p>Native decision resolver</p> }));
+vi.mock("@/lib/router", () => ({ Link: ({ to, children }: { to: string; children: ReactNode }) => <a href={to}>{children}</a> }));
+const agent = { id: "bot", companyId: "company", name: "Nora", status: "running" } as Agent;
+const task = { id: "task", identifier: "DEMO-1", companyId: "company", assigneeAgentId: "bot", title: "Kontaktseite", status: "in_review", createdAt: new Date("2026-01-01") } as CompactIssue;
+const back = vi.fn(), resolved = vi.fn();
+let root: Root, host: HTMLDivElement, client: QueryClient;
+function Harness() {
+  const [draft, setDraft] = useState<ChatDraft>({ text: "", replyTo: null, files: [] });
+  return <KlarBotChat companyId="company" agent={agent} agents={[agent]} draft={draft} onDraftChange={setDraft} onBack={back} onResolved={resolved} onPendingChange={() => {}} />;
+}
+beforeEach(async () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  Object.values(api).forEach(mock => mock.mockReset()); back.mockReset(); resolved.mockReset();
+  api.listCompact.mockResolvedValue([task]); api.listComments.mockResolvedValue([]); api.listAttachments.mockResolvedValue([]);
+  api.get.mockResolvedValue({ ...task, description: "Die Kontaktseite vereinfachen." });
+  client = new QueryClient({ defaultOptions: { queries: { retry: false }, mutations: { retry: false } } });
+  host = document.createElement("div"); document.body.append(host); root = createRoot(host);
+  await act(async () => root.render(<QueryClientProvider client={client}><Harness /></QueryClientProvider>));
+  await act(async () => { await new Promise(resolve => setTimeout(resolve, 25)); });
+});
+afterEach(async () => { await act(async () => root.unmount()); host.remove(); client.clear(); });
+describe("Klar chat navigation", () => {
+  it("keeps incoming messages in the chat without a pinned approval section", async () => {
+    await act(async () => {
+      client.setQueryData([...queryKeys.issues.comments("task"), "klar-chat", 12], [{ id: "latest", issueId: "task", companyId: "company", body: "Eine weitere Antwort.", authorAgentId: "bot", createdAt: new Date("2026-01-02") }]);
+    });
+    await act(async () => { await new Promise(resolve => setTimeout(resolve, 25)); });
+    const message = host.querySelector('[data-message-id="comment-latest"]')!;
+    expect(message).not.toBeNull();
+    expect(host.querySelector('.klar-pinned-decisions')).toBeNull();
+    expect(host.querySelector('[data-approval-id]')).toBeNull();
+  });
+  it("selects a task as the reply target and returns to the overview on back", async () => {
+    await act(async () => host.querySelector<HTMLButtonElement>('[aria-label="Auf DEMO-1 antworten"]')!.click());
+    expect(host.querySelector("textarea")?.getAttribute("aria-label")).toBe("Antwort auf DEMO-1");
+    await act(async () => host.querySelector<HTMLButtonElement>('[aria-label="Zur Bot-Übersicht"]')!.click());
+    expect(back).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/ui/src/components/KlarBotChat.tsx b/ui/src/components/KlarBotChat.tsx

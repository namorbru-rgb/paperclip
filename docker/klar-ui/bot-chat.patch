diff --git a/ui/src/components/useKlarVoice.ts b/ui/src/components/useKlarVoice.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9bbfcfd6439102568ab4c3676cc3dfe901ff3b4e
--- /dev/null
+++ b/ui/src/components/useKlarVoice.ts
@@ -0,0 +1,84 @@
+import { useEffect, useRef, useState } from "react";
+
+interface RecognitionResult { isFinal: boolean; [index: number]: { transcript: string } }
+interface Recognition {
+  lang: string; continuous: boolean; interimResults: boolean;
+  onresult: ((event: { results: ArrayLike<RecognitionResult> }) => void) | null;
+  onerror: ((event: { error: string }) => void) | null;
+  onend: (() => void) | null; start: () => void; stop: () => void; abort: () => void;
+}
+type SpeechWindow = { SpeechRecognition?: new () => Recognition; webkitSpeechRecognition?: new () => Recognition };
+export function useKlarVoice({ text, onText, onFile }: { text: string; onText: (text: string) => void; onFile: (file: File) => void }) {
+  const [mode, setMode] = useState<"dictating" | "recording" | "starting" | null>(null);
+  const [error, setError] = useState("");
+  const recognition = useRef<Recognition | null>(null);
+  const recorder = useRef<MediaRecorder | null>(null);
+  const stream = useRef<MediaStream | null>(null);
+  const timeout = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const active = useRef(true);
+  const callbacks = useRef({ onText, onFile });
+  callbacks.current = { onText, onFile };
+  const Speech = (window as unknown as SpeechWindow).SpeechRecognition ?? (window as unknown as SpeechWindow).webkitSpeechRecognition;
+  function stop() {
+    recognition.current?.stop();
+    if (recorder.current?.state === "recording") recorder.current.stop();
+    stream.current?.getTracks().forEach(track => track.stop());
+    if (timeout.current) clearTimeout(timeout.current);
+  }
+  useEffect(() => {
+    active.current = true;
+    return () => {
+      active.current = false;
+      recognition.current?.abort();
+      if (recorder.current?.state === "recording") recorder.current.stop();
+      stream.current?.getTracks().forEach(track => track.stop());
+      if (timeout.current) clearTimeout(timeout.current);
+    };
+  }, []);
+  function dictate() {
+    if (mode) { stop(); return; }
+    setError("");
+    if (!Speech) { setError("Dieser Browser bietet keine direkte Diktierfunktion. Nutze das Mikrofon deiner Tastatur oder nimm eine Sprachnotiz auf."); return; }
+    const speech = new Speech(); recognition.current = speech;
+    speech.lang = "de-CH"; speech.continuous = true; speech.interimResults = true;
+    const base = text.trimEnd();
+    speech.onresult = event => {
+      const words = Array.from(event.results).map(result => result[0].transcript).join(" ");
+      if (active.current) callbacks.current.onText([base, words].filter(Boolean).join(" "));
+    };
+    speech.onerror = event => {
+      if (active.current) setError(event.error === "not-allowed" ? "Bitte erlaube dem Browser den Mikrofonzugriff." : "Die Spracherkennung wurde unterbrochen. Der erkannte Text bleibt erhalten.");
+    };
+    speech.onend = () => { if (timeout.current) clearTimeout(timeout.current); recognition.current = null; if (active.current) setMode(null); };
+    try { speech.start(); setMode("dictating"); timeout.current = setTimeout(stop, 300_000); }
+    catch { setError("Die Spracherkennung konnte nicht gestartet werden."); }
+  }
+  async function record() {
+    if (mode) { stop(); return; }
+    setError("");
+    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === "undefined") { setError("Sprachnotizen benötigen einen Browser mit Mikrofonzugriff über HTTPS."); return; }
+    setMode("starting");
+    try {
+      const media = await navigator.mediaDevices.getUserMedia({ audio: true });
+      if (!active.current) { media.getTracks().forEach(track => track.stop()); return; }
+      stream.current = media;
+      const mimeType = ["audio/webm;codecs=opus", "audio/mp4", "audio/webm"].find(type => MediaRecorder.isTypeSupported(type));
+      const recording = new MediaRecorder(media, { ...(mimeType ? { mimeType } : {}), audioBitsPerSecond: 64_000 });
+      recorder.current = recording;
+      const chunks: Blob[] = [];
+      recording.ondataavailable = event => { if (event.data.size) chunks.push(event.data); };
+      recording.onstop = () => {
+        media.getTracks().forEach(track => track.stop());
+        if (timeout.current) clearTimeout(timeout.current);
+        if (!active.current) return;
+        const type = recording.mimeType.split(";")[0];
+        const blob = new Blob(chunks, { type });
+        if (blob.size) callbacks.current.onFile(new File([blob], `Sprachnotiz-${new Date().toISOString().replace(/[:.]/g, "-")}.${type.includes("mp4") ? "m4a" : type.includes("ogg") ? "ogg" : "webm"}`, { type }));
+        setMode(null);
+      };
+      recording.onerror = () => { if (active.current) { setError("Die Aufnahme wurde unterbrochen."); setMode(null); } media.getTracks().forEach(track => track.stop()); };
+      recording.start(); setMode("recording"); timeout.current = setTimeout(stop, 300_000);
+    } catch { stream.current?.getTracks().forEach(track => track.stop()); if (active.current) { setMode(null); setError("Das Mikrofon konnte nicht geöffnet werden. Prüfe die Mikrofonfreigabe im Browser."); } }
+  }
+  return { mode, error, dictate, record, stop };
+}

+import { describe, expect, it, vi, beforeEach } from "vitest";
+import type { Agent, CompactIssue, IssueComment } from "@paperclipai/shared";
+import { botRank, chatTimeline, decisionAgentId, newTaskAgent, priorityTaskPayload } from "./klar-chat";
+import { sendKlarMessage, type KlarSendProgress } from "./klar-send";
+const api = vi.hoisted(() => ({ create: vi.fn(), uploadAttachment: vi.fn(), update: vi.fn(), addComment: vi.fn() }));
+vi.mock("../api/issues", () => ({ issuesApi: api }));
+beforeEach(() => Object.values(api).forEach(mock => mock.mockReset()));
+
+describe("Klar chat rules", () => {
+  const team = [{ id: "atlas", companyId: "c", name: "Atlas", status: "idle", role: "engineer" }, { id: "lead", companyId: "c", name: "Leitung", status: "running", role: "ceo" }] as Agent[];
+  it("routes a named priority task without title, project or priority input fields", () => {
+    for (const text of ["Aufgabe für Atlas, vergleiche die Preise", "Atlas: vergleiche die Preise", "@Atlas vergleiche die Preise"]) {
+      expect(priorityTaskPayload(text, "c", team)).toEqual({ title: text, description: text, assigneeAgentId: "atlas", status: "todo", priority: "critical", workMode: "standard" });
+    }
+    expect(newTaskAgent("Vergleiche die Preise", "c", team).id).toBe("lead");
+  });
+  it("does not silently reroute unknown, ambiguous or unavailable named bots", () => {
+    expect(() => newTaskAgent("Aufgabe für Unbekannt, prüfen", "c", team)).toThrow("finde ich nicht");
+    expect(() => newTaskAgent("Atlas, prüfen", "c", [...team, { ...team[0], id: "duplicate" }])).toThrow("nicht eindeutig");
+    expect(() => newTaskAgent("Atlas, prüfen", "c", [{ ...team[0], status: "paused" }, team[1]])).toThrow("nicht einsatzbereit");
+    expect(() => newTaskAgent("Bitte prüfen", "c", [team[0]])).toThrow("nicht eindeutig");
+  });
+  it("cannot assign a new task to a bot or coordinator in another company", () => {
+    expect(() => newTaskAgent("Aufgabe für Atlas, prüfen", "other", team)).toThrow("finde ich nicht");
+    expect(() => newTaskAgent("Bitte prüfen", "other", team)).toThrow("nicht eindeutig");
+  });
+  it("ranks decisions, working, stopped and idle bots in the requested order", () => {
+    const make = (id: string, status: string) => ({ id, name: id, status }) as Agent;
+    const bots = [make("idle", "idle"), make("error", "error"), make("busy", "running"), make("approval", "idle")];
+    expect(bots.sort((a, b) => botRank(a, a.id === "approval" ? 1 : 0, []) - botRank(b, b.id === "approval" ? 1 : 0, [])).map(bot => bot.id)).toEqual(["approval", "busy", "error", "idle"]);
+  });
+  it("does not mistake a completed run for a running bot", () => {
+    const bot = { id: "a", status: "idle" } as Agent;
+    expect(botRank(bot, 0, [{ agentId: "a", status: "succeeded", finishedAt: "today" }] as never)).toBe(3);
+  });
+  it("merges task and reply timestamps without crossing company boundaries or showing deleted comments", () => {
+    const tasks = [{ id: "t", companyId: "c", createdAt: new Date("2026-01-01") }] as CompactIssue[];
+    const comment = { id: "b", issueId: "t", companyId: "c", createdAt: new Date("2026-01-03") } as IssueComment;
+    expect(chatTimeline(tasks, [comment, { ...comment, id: "a", createdAt: new Date("2026-01-02") }, { ...comment, id: "foreign", companyId: "other" }, { ...comment, id: "deleted", deletedAt: new Date() }]).map(event => event.id)).toEqual(["task-t", "comment-a", "comment-b"]);
+  });
+  it("maps decisions by stable identities rather than display names", () => {
+    expect(decisionAgentId({ subject: { metadata: { createdByAgentId: "agent-id" } }, originAgentName: "Same name" } as never)).toBe("agent-id");
+    expect(decisionAgentId({ subject: {}, originAgentName: "Same name" } as never)).toBeNull();
+  });
+});
+describe("Attachment handoff", () => {
+  const createProgress = (): KlarSendProgress => ({ companyId: "c", agentId: "a", text: "Nutze die Dateien.", files: [{ name: "one.pdf" }, { name: "two.png" }] as File[], target: null, attachments: [], committing: false });
+  it("keeps a partial upload as an unassigned draft and resumes without creating a second task", async () => {
+    const progress = createProgress();
+    api.create.mockResolvedValue({ id: "draft" });
+    api.uploadAttachment.mockResolvedValueOnce({ id: "f1", originalFilename: "one.pdf" }).mockRejectedValueOnce(new Error("offline"));
+    await expect(sendKlarMessage(progress)).rejects.toThrow("offline");
+    expect(api.update).not.toHaveBeenCalled();
+    expect(api.create.mock.calls[0][1]).not.toHaveProperty("assigneeAgentId");
+    expect(progress.attachments).toHaveLength(1);
+    api.uploadAttachment.mockResolvedValueOnce({ id: "f2", originalFilename: "two.png" });
+    api.update.mockResolvedValue({ id: "draft" });
+    await sendKlarMessage(progress);
+    expect(api.create).toHaveBeenCalledTimes(1);
+    expect(api.update).toHaveBeenCalledWith("draft", expect.objectContaining({ status: "todo", assigneeAgentId: "a" }));
+    expect(api.update.mock.calls[0][1].description).toContain("/api/attachments/f1/content");
+    expect(api.update.mock.calls[0][1].description).toContain("/api/attachments/f2/content");
+  });
+  it("does not repeat a final write when its outcome is unknown", async () => {
+    const progress = createProgress(); progress.files = [];
+    api.create.mockResolvedValue({ id: "draft" });
+    api.update.mockRejectedValue(new Error("connection lost"));
+    await expect(sendKlarMessage(progress)).rejects.toThrow("connection lost");
+    await expect(sendKlarMessage(progress)).rejects.toThrow("geprüft");
+    expect(api.update).toHaveBeenCalledTimes(1);
+  });
+  it("uploads before notifying an existing task", async () => {
+    const progress = createProgress(); progress.target = { id: "existing" } as never;
+    api.uploadAttachment.mockResolvedValue({ id: "file", originalFilename: "doc.pdf" });
+    await sendKlarMessage(progress);
+    expect(api.create).not.toHaveBeenCalled();
+    expect(api.addComment).toHaveBeenCalledWith("existing", expect.stringContaining("/api/attachments/file/content"));
+    expect(api.addComment.mock.invocationCallOrder[0]).toBeGreaterThan(api.uploadAttachment.mock.invocationCallOrder[1]);
+  });
+});
